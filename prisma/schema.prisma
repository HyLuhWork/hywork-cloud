generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so the following are plain
// strings constrained by the application layer (zod schemas at the API
// boundary): SessionTimeoutUnit = "MINUTES" | "HOURS",
// DevicePolicy = "MULTIPLE" | "SINGLE", MfaPolicy = "OPTIONAL" | "REQUIRED",
// UserRole = "ADMIN" | "MEMBER".

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  securitySettings SecuritySettings?
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  role         String    @default("MEMBER")
  isActive     Boolean   @default(true)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  passwordHistory PasswordHistory[]

  @@unique([tenantId, email])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  tenantId       String
  tokenHash      String    @unique
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  revokedAt      DateTime?
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  passwordHash String
  createdAt    DateTime @default(now())
}

// Tenant-wide security policy configuration for the Security Center.
model SecuritySettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // 1. Session inactivity timeout
  sessionTimeoutEnabled Boolean @default(true)
  sessionTimeoutValue   Int     @default(30)
  sessionTimeoutUnit    String  @default("MINUTES")

  // 2. Automatic deactivation of inactive users
  inactiveUserDeactivationEnabled Boolean @default(false)
  inactiveUserDeactivationDays    Int     @default(90)

  // 3. Multiple-device restriction
  devicePolicy String @default("MULTIPLE")

  // 4. Password complexity policy
  passwordMinLength          Int     @default(8)
  passwordMaxLength          Int?
  passwordRequireUppercase   Boolean @default(true)
  passwordRequireLowercase   Boolean @default(true)
  passwordRequireNumber      Boolean @default(true)
  passwordRequireSpecialChar Boolean @default(false)

  // 5. Password history / reuse prevention
  passwordHistoryEnabled Boolean @default(true)
  passwordHistoryCount   Int     @default(3)

  // 6. MFA requirement
  // mfaEnabled is the master switch for the whole MFA section; mfaPolicy only
  // takes effect while it's on. mfaPolicy: "OPTIONAL" | "REQUIRED_ALL" | "REQUIRED_BY_ROLE".
  // mfaRequiredRoles is a comma-separated list of UserRole values, only read
  // when mfaPolicy is "REQUIRED_BY_ROLE" (this app has roles, not arbitrary
  // groups, so "grupo/perfil" maps to role).
  mfaEnabled                 Boolean @default(false)
  mfaPolicy                  String  @default("OPTIONAL")
  mfaRequiredRoles           String  @default("")
  mfaMethodAuthenticatorApp  Boolean @default(true)
  mfaMethodSms               Boolean @default(false)
  mfaMethodEmail             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
